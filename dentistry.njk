<script>
// Dental checkout. Unlike the homepage this ALWAYS posts to create-checkout,
// including for a single panel. The single-specialty Stripe Payment Link
// carries a fixed "use your NHS or institutional email" tip set in the Stripe
// dashboard, which is wrong for practice-based dentists; routing everything
// through the function keeps that message dynamic and removes a dashboard
// object that can drift out of sync.
var CHECKOUT_FUNCTION = '/.netlify/functions/create-checkout';
var PRIMARY_GBP = 20, EXTRA_GBP = 5;

var dentPrimary = document.getElementById('dent-primary');
var dentExtrasEl = document.getElementById('dent-extras');
var dentTotalEl = document.getElementById('dent-total');
var dentBtn = document.getElementById('dent-btn');

var DENT_PANELS = Array.prototype.map.call(dentPrimary.options, function (o) {
  return { value: o.value, label: o.text };
});

function buildDentExtras() {
  var primary = dentPrimary.value;
  dentExtrasEl.innerHTML = '';
  DENT_PANELS.forEach(function (p) {
    if (p.value === primary) return;
    var label = document.createElement('label');
    label.className = 'dent-extra';
    var cb = document.createElement('input');
    cb.type = 'checkbox';
    cb.value = p.value;
    cb.addEventListener('change', updateDentTotal);
    label.appendChild(cb);
    label.appendChild(document.createTextNode(p.label));
    dentExtrasEl.appendChild(label);
  });
  updateDentTotal();
}

function dentExtras() {
  return Array.prototype.slice
    .call(dentExtrasEl.querySelectorAll('input[type=checkbox]:checked'))
    .map(function (cb) { return cb.value; });
}

function updateDentTotal() {
  var n = dentExtras().length;
  var total = PRIMARY_GBP + n * EXTRA_GBP;
  dentTotalEl.textContent = n === 0
    ? '\u00a3' + total + ' a year after your free trial'
    : '\u00a3' + total + ' a year after your free trial \u2014 1 panel plus ' + n + (n === 1 ? ' extra' : ' extras');
}

function dentCheckout() {
  var primary = dentPrimary.value;
  if (!primary) return;
  dentBtn.disabled = true;
  dentBtn.textContent = 'Redirecting to checkout\u2026';
  fetch(CHECKOUT_FUNCTION, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ primary: primary, extras: dentExtras() })
  })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert('Something went wrong. Please try again, or email info@mondayclinicalbrief.co.uk');
        dentBtn.disabled = false;
        dentBtn.textContent = 'Start free trial';
      }
    })
    .catch(function () {
      alert('Something went wrong. Please try again, or email info@mondayclinicalbrief.co.uk');
      dentBtn.disabled = false;
      dentBtn.textContent = 'Start free trial';
    });
}

dentPrimary.addEventListener('change', buildDentExtras);
buildDentExtras();
</script>

