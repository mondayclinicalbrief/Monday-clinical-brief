<script>
// Filter the specialty panels by name. Progressive enhancement: with JS off
// every panel is already in the DOM and readable.
(function () {
  var input = document.getElementById('panel-filter');
  var count = document.getElementById('panel-count');
  if (!input) return;
  var panels = Array.prototype.slice.call(
    document.querySelectorAll('#panel-list .panel, #panel-list-dental .panel')
  );
  var medical = document.querySelectorAll('#panel-list .panel').length;
  input.addEventListener('input', function () {
    var q = this.value.trim().toLowerCase();
    var shown = 0;
    panels.forEach(function (p) {
      var hit = !q || p.dataset.name.indexOf(q) !== -1;
      p.hidden = !hit;
      if (hit) shown++;
    });
    count.textContent = q
      ? shown + (shown === 1 ? ' match' : ' matches')
      : medical + ' specialties';
  });
})();

// Measure the fixed mobile bottom bar so the body reserves its true height.
(function () {
  var nav = document.querySelector('nav');
  if (!nav) return;
  function sync() {
    var fixed = getComputedStyle(nav).position === 'fixed';
    document.documentElement.style.setProperty(
      '--bottom-nav-h', fixed ? nav.offsetHeight + 'px' : '0px'
    );
  }
  sync();
  addEventListener('resize', sync);
  addEventListener('orientationchange', sync);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(sync);
  if (window.ResizeObserver) new ResizeObserver(sync).observe(nav);
})();
</script>

