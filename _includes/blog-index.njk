<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — The Monday Clinical Brief</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://mondayclinicalbrief.co.uk{{ page.url }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="https://mondayclinicalbrief.co.uk{{ page.url }}">
<meta property="og:site_name" content="The Monday Clinical Brief">
<meta property="og:image" content="https://mondayclinicalbrief.co.uk/assets/brand/mcb-og-1200x630-v2.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="The Monday Clinical Brief — weekly journal digests for UK clinicians">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="https://mondayclinicalbrief.co.uk/assets/brand/mcb-og-1200x630-v2.png">

<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root {
    --charcoal: #1c1c1c;
    --cream: #f7f5f0;
    --warm-white: #fdfcf9;
    --sage: #5a7a6a;
    --sage-light: #e8efeb;
    --sage-deep: #3d5a4c;
    --gold: #c4994c;
    --gold-light: #f5edd8;
    --text: #3a3a38;
    --text-muted: #7a7a76;
    --border: #e2dfd8;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Figtree', sans-serif; color: var(--text); background: var(--warm-white); line-height: 1.7; -webkit-font-smoothing: antialiased; }

  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; background: rgba(247,245,240,0.9); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(226,223,216,0.5); }
  .nav-brand { font-family: 'Instrument Serif', serif; font-size: 1.8rem; font-weight: 700; color: var(--charcoal); text-decoration: none; letter-spacing: -0.02em; }
  .nav-links { display: flex; gap: 1.5rem; align-items: center; }
  .nav-links a { font-size: 0.85rem; color: var(--text-muted); text-decoration: none; font-weight: 500; transition: color 0.2s; }
  .nav-links a:hover { color: var(--sage-deep); }
  .nav-cta { text-align: center; background: var(--sage-deep); color: white !important; padding: 0.5rem 1.25rem; border-radius: 40px; font-size: 0.85rem; }
  .nav-cta:hover { background: var(--charcoal); }

  .blog-hero { padding: 7rem 2rem 3rem; background: var(--cream); text-align: center; }
  .blog-hero h1 { font-family: 'Instrument Serif', serif; font-size: clamp(2rem, 4.5vw, 2.8rem); font-weight: 400; color: var(--charcoal); line-height: 1.2; margin-bottom: 0.75rem; }
  .blog-hero p { color: var(--text-muted); font-size: 1.05rem; max-width: 560px; margin: 0 auto; }

  .cluster-nav { display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; padding: 1.5rem 2rem; border-bottom: 1px solid var(--border); }
  .cluster-link { display: inline-block; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.82rem; font-weight: 600; text-decoration: none; border: 1px solid var(--border); color: var(--text-muted); transition: all 0.2s; }
  .cluster-link:hover, .cluster-link.active { background: var(--sage-light); border-color: var(--sage); color: var(--sage-deep); }

  .posts-grid { max-width: 900px; margin: 0 auto; padding: 2.5rem 2rem; display: grid; gap: 1.5rem; }
  .post-card { background: white; border: 1px solid var(--border); border-radius: 8px; padding: 1.75rem; transition: all 0.2s; }
  .post-card:hover { border-color: var(--sage); box-shadow: 0 4px 16px rgba(0,0,0,0.05); }
  .post-card-cluster { display: inline-block; background: var(--sage-light); color: var(--sage-deep); padding: 0.15rem 0.5rem; border-radius: 3px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 0.75rem; }
  .post-card h2 { font-family: 'Instrument Serif', serif; font-size: 1.3rem; font-weight: 400; color: var(--charcoal); line-height: 1.3; margin-bottom: 0.5rem; }
  .post-card h2 a { color: inherit; text-decoration: none; }
  .post-card h2 a:hover { color: var(--sage-deep); }
  .post-card p { color: var(--text-muted); font-size: 0.92rem; margin-bottom: 0.75rem; }
  .post-card-meta { font-size: 0.8rem; color: var(--text-muted); display: flex; gap: 1rem; }
  .pillar-badge { display: inline-block; background: var(--gold-light); color: var(--gold); padding: 0.15rem 0.5rem; border-radius: 3px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; margin-left: 0.5rem; }

  footer { padding: 3rem 2rem; text-align: center; border-top: 1px solid var(--border); }
  footer p { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.5rem; }
  footer a { color: var(--sage); text-decoration: none; }

  @media (max-width: 640px) {
    /* Fixed bottom bar on mobile — reserve its measured height, not a flat
       60px, or the two-line brand hides the footer at ~390px. */
    nav { padding: 0.75rem 1rem; position: fixed; top: auto; bottom: 0; border-bottom: none; border-top: 1px solid rgba(226,223,216,0.5); align-items: center; gap: 0.75rem; }
    .nav-brand { font-size: 0.9rem; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
    .nav-cta { flex-shrink: 0; }
    .nav-links a:not(.nav-cta) { display: none; }
    body { padding-bottom: calc(var(--bottom-nav-h, 64px) + env(safe-area-inset-bottom, 0px)); }
    .blog-hero { padding-top: 3rem; }
  }
</style>
</head>
<body>

<nav>
  <a href="/" class="nav-brand">The Monday Clinical Brief</a>
  <div class="nav-links">
    <a href="/samples/">Samples</a>
    <a href="/blog/">Blog</a>
    <a href="/#how">How it works</a>
    <a href="/#subscribe" class="nav-cta">Start free trial</a>
  </div>
</nav>

<main id="main">
<div class="blog-hero">
  <h1>{{ title }}</h1>
  <p>{{ description }}</p>
</div>

<div class="cluster-nav">
  <a href="/blog/" class="cluster-link{% if page.url == '/blog/' %} active{% endif %}">All posts</a>
  <a href="/blog/medical-journal-digest/" class="cluster-link{% if '/medical-journal-digest' in page.url %} active{% endif %}">Medical Journal Digest</a>
  <a href="/blog/cpd-reading-tool/" class="cluster-link{% if '/cpd-reading-tool' in page.url %} active{% endif %}">CPD and Revalidation</a>
  <a href="/blog/journal-summary-subscription/" class="cluster-link{% if '/journal-summary-subscription' in page.url %} active{% endif %}">Journal Summary Subscription</a>
</div>

<div class="posts-grid">
  {{ content | safe }}
</div>
</main>

<footer>
  <p>&copy; 2026 The Monday Clinical Brief. All rights reserved.</p>
  <p><a href="/samples/">Samples</a> · <a href="/blog/">Blog</a> · <a href="/methodology/">Methodology</a> · <a href="/about/">About</a> · <a href="/privacy.html">Privacy</a> · <a href="/terms.html">Terms</a></p>
</footer>

<script>
// Measure the fixed mobile bottom bar so the body reserves its true height.
(function () {
  var nav = document.querySelector('nav');
  if (!nav) return;
  function sync() {
    var fixed = getComputedStyle(nav).position === 'fixed';
    document.documentElement.style.setProperty(
      '--bottom-nav-h', fixed ? nav.offsetHeight + 'px' : '0px'
    );
  }
  sync();
  addEventListener('resize', sync);
  addEventListener('orientationchange', sync);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(sync);
  if (window.ResizeObserver) new ResizeObserver(sync).observe(nav);
})();
</script>

</body>
</html>
